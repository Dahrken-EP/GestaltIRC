# Caddy gets and renews the HTTPS certificate by itself, proxies the WebSocket as
# well as the web client, and sends the headers the bouncer reads to tell that the
# request arrived over TLS (X-Forwarded-Proto) and from which address (X-Forwarded-For).
{$DOMAIN} {
	encode zstd gzip

	# The bouncer sends the security headers itself (content security policy, frame rules, nosniff,
	# referrer and permissions policies, and Strict-Transport-Security once sts_duration is set). They
	# differ by page: only the plugin sandbox page may be framed. Setting any of them here would
	# overwrite the bouncer's, so only the server banner is touched.
	header -Server

	reverse_proxy bouncer:8080 {
		# Pushes and previews can take a while; a WebSocket must not be cut off.
		transport http {
			read_timeout 0
		}
	}
}
