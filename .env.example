# Copy to .env and edit. Used by docker-compose.yml.

# The address people will visit. Point its DNS record at this server first, or Caddy cannot get a certificate.
# "localhost" is fine for trying the stack on your own machine (your browser will warn about the certificate).
DOMAIN=irc.example.org

# The server's public IP address. Needed for voice and file transfer when the server sits behind NAT, as most
# cloud servers do (the provider's dashboard shows it). Leave empty on a machine with a public address of its own.
PUBLIC_IP=

# Where the TURN relay is reached. Defaults to DOMAIN. Set it only if it has a name of its own.
TURN_HOST=

# A real address: push services use it as the contact for this server. Defaults to admin@DOMAIN.
ADMIN_EMAIL=

# Only with docker-compose.proxy.yml (an existing reverse proxy in front): where the bouncer is published for it.
# Use BOUNCER_BIND=0.0.0.0 only if the proxy is on another machine, and then firewall the port to that machine.
#BOUNCER_PORT=8081
#BOUNCER_BIND=127.0.0.1

# Only with docker-compose.traefik.yml (Traefik already terminates HTTPS): the names must match your Traefik.
#TRAEFIK_NETWORK=traefik
#TRAEFIK_ENTRYPOINT=websecure
#TRAEFIK_CERTRESOLVER=letsencrypt
