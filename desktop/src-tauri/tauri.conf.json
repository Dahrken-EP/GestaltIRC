{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestalt",
  "version": "0.1.7",
  "identifier": "net.gestalt.desktop",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "resources": { "resources/": "resources/" },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "exceptionDomain": [],
      "frameworks": [],
      "providerShortName": null,
      "signingIdentity": null,
      "entitlements": "Entitlements.plist"
    }
  },
  "tauriUpdater": {
    "enabled": true,
    "url": "https://github.com/Dahrken-EP/GestaltIRC/releases/latest/download/Gestalt-latest.AppImage",
    "updateChannel": "stable",
    "autoDownload": false,
    "downloadPath": "/tmp/"
  }
}
